# Frontend environment (copy to .env for local overrides)
#
# Leave this empty for local development: the app then uses
#   http://localhost:8000      (web / iOS simulator)
#   http://10.0.2.2:8000       (Android emulator)
#
# For a production build (APK / deployed web), point it at the Render backend:
# EXPO_PUBLIC_API_URL=https://your-service.onrender.com
EXPO_PUBLIC_API_URL=
