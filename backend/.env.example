# SHE SAFE AI — Backend Configuration
# Copy this file to .env and fill in your values.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- AI Provider (optional — falls back to built-in safety engine if unset) ---
# Supported: openai, anthropic, google
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini

# --- CORS (Flutter dev server / emulator) ---
# Use "*" for development only. Restrict in production.
CORS_ORIGINS=*
